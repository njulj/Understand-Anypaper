{
  "name": "understand-anypaper-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "doctor:bindings": "node ./scripts/ensure-vite-native.cjs",
    "build": "npm run doctor:bindings && tsc && vite build --base ./",
    "electron:dev": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder",
    "desktop:dist:mac": "bash ../../scripts/package-desktop-macos.sh",
    "desktop:dist:win": "powershell -ExecutionPolicy Bypass -File ../../scripts/package-desktop-windows.ps1",
    "desktop:dist:linux": "bash ../../scripts/package-desktop-linux.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "d3-force": "^3.0.0",
    "jsmind": "^0.9.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^33.2.1",
    "electron-builder": "^26.11.1"
  },
  "build": {
    "appId": "com.aritxonly.understand-anypaper",
    "productName": "Understand Anypaper",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../release/staging/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../release/staging/launcher",
        "to": "launcher",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/assets/macOS-iOS-Default-1024@1x.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage"
      ]
    }
  }
}
