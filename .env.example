DATABASE_URL=postgresql+psycopg://understand:understand@localhost:5432/understand_anypaper
PAG_RECURSION_MAX_DEPTH=1
PAG_RECURSION_MAX_PAPERS=5
# Optional. OpenAlex singleton DOI lookups work without a key, but a free key
# provides a larger daily API allowance.
PAG_OPENALEX_API_KEY=

# LLM configuration. Graph building requires an LLM; uploads fail when the
# graph agent starts without OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
PAG_OPENAI_MODEL=google/gemini-3-flash-preview
PAG_SEND_PROMPT_CACHE_KEY=true
PAG_GRAPH_AGENT_MAX_TURNS=40
PAG_GRAPH_AGENT_MAX_TOOL_CALLS=120
PAG_GRAPH_AGENT_SHELL_TIMEOUT_SECONDS=30

# LLM observability (optional). `devbox services up` already starts Arize
# Phoenix (UI at http://localhost:6006) and points the server at it. For runs
# outside devbox services, set these to export traces; unset disables tracing.
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#ENABLE_SENSITIVE_DATA=true
