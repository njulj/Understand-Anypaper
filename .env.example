DATABASE_URL=postgresql+psycopg://understand:understand@localhost:5432/understand_anypaper
PAG_RECURSION_MAX_DEPTH=1
PAG_RECURSION_MAX_PAPERS=5

# LLM configuration. Graph building requires an LLM: without OPENAI_API_KEY,
# uploads fail at the semantic slicing step and vector search is disabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PAG_OPENAI_MODEL=gpt-4o-mini
PAG_EMBEDDING_MODEL=text-embedding-3-small
PAG_EMBEDDING_DIMENSIONS=1536

# LLM observability (optional). `devbox services up` already starts Arize
# Phoenix (UI at http://localhost:6006) and points the server at it. For runs
# outside devbox services, set these to export traces; unset disables tracing.
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#ENABLE_SENSITIVE_DATA=true
