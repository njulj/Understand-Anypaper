DATABASE_URL=postgresql+psycopg://understand:understand@localhost:5432/understand_anypaper
PAG_RECURSION_MAX_DEPTH=1
PAG_RECURSION_MAX_PAPERS=5
CODEX_CLI=codex

# Optional LLM configuration. Leave OPENAI_API_KEY empty to run fully offline
# with the rule-based analyzers (no LLM roles/contributions, no vector search).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PAG_OPENAI_MODEL=gpt-4o-mini
PAG_EMBEDDING_MODEL=text-embedding-3-small
PAG_EMBEDDING_DIMENSIONS=1536
